#!/usr/bin/env python3
from pathlib import Path
import os
import sys

if sys.version_info < (3, 14):
    # Bare runners use this command in projects without scripts/qk. Like that launcher,
    # find a supported interpreter later on PATH before loading the package.
    import subprocess
    seen = {os.path.realpath(sys.executable)}
    for folder in [] if "QUEUEKEEPER_LAUNCHER_PYTHON" in os.environ else os.environ.get("PATH", "").split(os.pathsep):
        other = os.path.join(folder, "python3")
        if not folder or os.path.realpath(other) in seen or not os.access(other, os.X_OK): continue
        seen.add(os.path.realpath(other))
        try: new = subprocess.call([other, "-c", "import sys; sys.exit(sys.version_info < (3, 14))"], timeout=30) == 0
        except (OSError, subprocess.SubprocessError): new = False
        if new:
            os.environ["QUEUEKEEPER_LAUNCHER_PYTHON"] = other
            os.execv(other, [other, __file__, *sys.argv[1:]])
    print(f"queuekeeper: needs Python 3.14 or newer, and {sys.executable} is {sys.version.split()[0]}", file=sys.stderr)
    raise SystemExit(2)
os.environ.pop("QUEUEKEEPER_LAUNCHER_PYTHON", None)

home = Path(__file__).resolve().parents[1]
# QUEUEKEEPER_ROOT names the Queuekeeper checkout the run selected, such as a merge queue worker's copy, which
# its lanes and the commands they start must load: another checkout's qk, the installed one, hands over to it,
# rather than load a second Queuekeeper that a project's hooks refuse (vocaro/queuekeeper#340). The checkout handed
# to marks its handover, so that it never hands over again.
named = os.environ.get("QUEUEKEEPER_ROOT")
followed = os.environ.pop("QUEUEKEEPER_FOLLOWED_ROOT", None)
if named and followed is None:
    selected = Path(named).expanduser().resolve()
    if selected != home and (selected / "bin/qk").is_file() \
            and (selected / "src/python/queuekeeper/cli.py").is_file():
        os.environ["QUEUEKEEPER_FOLLOWED_ROOT"] = str(selected)
        os.execv(sys.executable, [sys.executable, str(selected / "bin/qk"), *sys.argv[1:]])
sys.path.insert(0, str(home / "src/python"))
try:
    from queuekeeper.checkout import activate
    activate(home)
    from queuekeeper.cli import main
except (ImportError, SyntaxError):
    if (home / ".git/HEAD").is_file():
        print(f"queuekeeper: could not load Queuekeeper from {home}. Inspect that checkout with git status.",
              file=sys.stderr, flush=True)
    raise

raise SystemExit(main())
