#!/usr/bin/env python3
"""A project's launcher for Queuekeeper: it runs Queuekeeper on the project this file is in.

It finds Queuekeeper where QUEUEKEEPER_ROOT names it, else in this checkout when this is Queuekeeper's own,
else in ~/Development/queuekeeper."""
import os
from pathlib import Path
import sys

if sys.version_info < (3, 14):
    # A project that runs this launcher under an interpreter of its own, such as a pinned environment's, gets in its
    # place, once, the first python3 on the PATH that is new enough, which need not be the first there: such an
    # environment puts its own ahead. The lanes it runs still use whatever their commands name.
    import subprocess
    seen = {os.path.realpath(sys.executable)}
    for folder in [] if "QUEUEKEEPER_LAUNCHER_PYTHON" in os.environ else os.environ.get("PATH", "").split(os.pathsep):
        other = os.path.join(folder, "python3")
        if not folder or os.path.realpath(other) in seen or not os.access(other, os.X_OK): continue
        seen.add(os.path.realpath(other))
        try: new = subprocess.call([other, "-c", "import sys; sys.exit(sys.version_info < (3, 14))"], timeout=30) == 0
        except (OSError, subprocess.SubprocessError): new = False
        if new:
            os.environ["QUEUEKEEPER_LAUNCHER_PYTHON"] = other
            os.execv(other, [other, __file__, *sys.argv[1:]])
    print(f"queuekeeper: needs Python 3.14 or newer, and {sys.executable} is {sys.version.split()[0]}", file=sys.stderr)
    raise SystemExit(2)
os.environ.pop("QUEUEKEEPER_LAUNCHER_PYTHON", None)

root = Path(__file__).resolve().parents[1]
named = os.environ.get("QUEUEKEEPER_ROOT")
home = (root / named).resolve() if named else root if (root / "src/python/queuekeeper/cli.py").is_file() \
    else Path.home() / "Development/queuekeeper"
if not (home / "src/python/queuekeeper/cli.py").is_file():
    print(f"queuekeeper: no Queuekeeper at {home}. Clone vocaro/queuekeeper there or set QUEUEKEEPER_ROOT.",
          file=sys.stderr)
    raise SystemExit(2)
sys.path.insert(0, str(home / "src/python"))
from queuekeeper.checkout import activate
activate(home)
from queuekeeper.cli import main

raise SystemExit(main(["--project", str(root), *sys.argv[1:]]))
