#!/usr/bin/env python3
"""A project's launcher for Queuekeeper: it runs Queuekeeper on the project this file is in.

It finds Queuekeeper where QUEUEKEEPER_ROOT names it, else in this checkout when this is Queuekeeper's own,
else in ~/Development/queuekeeper."""
import os
from pathlib import Path
import sys

if sys.version_info < (3, 14):
    print(f"queuekeeper: needs Python 3.14 or newer, and {sys.executable} is {sys.version.split()[0]}", file=sys.stderr)
    raise SystemExit(2)

root = Path(__file__).resolve().parents[1]
named = os.environ.get("QUEUEKEEPER_ROOT")
home = (root / named).resolve() if named else root if (root / "src/python/queuekeeper/cli.py").is_file() \
    else Path.home() / "Development/queuekeeper"
if not (home / "src/python/queuekeeper/cli.py").is_file():
    print(f"queuekeeper: no Queuekeeper at {home}. Clone vocaro/queuekeeper there or set QUEUEKEEPER_ROOT.",
          file=sys.stderr)
    raise SystemExit(2)
sys.path.insert(0, str(home / "src/python"))
from queuekeeper.cli import main

raise SystemExit(main(["--project", str(root), *sys.argv[1:]]))
